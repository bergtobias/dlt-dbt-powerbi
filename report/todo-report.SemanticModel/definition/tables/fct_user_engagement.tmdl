table fct_user_engagement
	lineageTag: 06b01ae3-2c5d-44b6-9b93-d676f485286e

	measure 'Total Users' = COUNTROWS(fct_user_engagement)
		lineageTag: 5e9bb5b2-b29d-4013-851f-07dcf153ba77

	measure 'Total Todos' = SUM(fct_user_engagement[todo_count])
		lineageTag: a1b2c3d4-e5f6-7890-abcd-ef1234567890

	measure 'Completed Todos' = SUM(fct_user_engagement[completed_todos])
		lineageTag: b2c3d4e5-f6a7-8901-bcde-f12345678901

	measure 'Avg Completion Rate' = AVERAGE(fct_user_engagement[completion_rate])
		formatString: 0.0%
		lineageTag: 98caf75b-41c7-409d-9c32-5ca7b3b11fd3

