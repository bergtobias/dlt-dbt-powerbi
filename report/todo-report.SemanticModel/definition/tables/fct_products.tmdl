table fct_products
	lineageTag: a1b2c3d4-e5f6-7890-abcd-111222333444

	measure 'Total Products' = COUNTROWS(fct_products)
		lineageTag: f2a3b4c5-d6e7-8901-fabc-cccdddeeefff

	measure 'Avg Price' = AVERAGE(fct_products[price])
		formatString: \#,0.00
		lineageTag: a3b4c5d6-e7f8-9012-abcd-dddeeefff000

	measure 'Avg Product Rating' = AVERAGE(fct_products[rating])
		formatString: 0.00
		lineageTag: b4c5d6e7-f8a9-0123-bcde-eeeffffaaabb

	measure 'Total Stock' = SUM(fct_products[stock])
		lineageTag: c5d6e7f8-a9b0-1234-cdef-ffffaaabbbcc

