table fct_recipes
	lineageTag: aa110011-bb22-cc33-dd44-ee5566778899

	column recipe_id
		dataType: int64
		lineageTag: bb220022-cc33-dd44-ee55-ff6677889900
		summarizeBy: none
		sourceColumn: recipe_id

	column name
		dataType: string
		lineageTag: cc330033-dd44-ee55-ff66-007788990011
		summarizeBy: none
		sourceColumn: name

	column cuisine
		dataType: string
		lineageTag: dd440044-ee55-ff66-0077-118899001122
		summarizeBy: none
		sourceColumn: cuisine

	column difficulty
		dataType: string
		lineageTag: ee550055-ff66-0077-1188-229900112233
		summarizeBy: none
		sourceColumn: difficulty

	column meal_type
		dataType: string
		lineageTag: ff660066-0077-1188-2299-330011223344
		summarizeBy: none
		sourceColumn: meal_type

	column prep_time_minutes
		dataType: int64
		lineageTag: 00770077-1188-2299-33aa-440122334455
		summarizeBy: average
		sourceColumn: prep_time_minutes

	column cook_time_minutes
		dataType: int64
		lineageTag: 11880088-2299-33aa-44bb-550233445566
		summarizeBy: average
		sourceColumn: cook_time_minutes

	column total_time_minutes
		dataType: int64
		lineageTag: 22990099-33aa-44bb-55cc-660344556677
		summarizeBy: average
		sourceColumn: total_time_minutes

	column servings
		dataType: int64
		lineageTag: 33aa00aa-44bb-55cc-66dd-770455667788
		summarizeBy: average
		sourceColumn: servings

	column calories_per_serving
		dataType: int64
		lineageTag: 44bb00bb-55cc-66dd-77ee-880566778899
		summarizeBy: average
		sourceColumn: calories_per_serving

	column rating
		dataType: double
		lineageTag: 55cc00cc-66dd-77ee-88ff-990677889900
		summarizeBy: average
		sourceColumn: rating
		formatString: 0.00

	column review_count
		dataType: int64
		lineageTag: 66dd00dd-77ee-88ff-9900-aa0788990011
		summarizeBy: sum
		sourceColumn: review_count

	column total_calories
		dataType: int64
		lineageTag: 77ee00ee-88ff-9900-aa11-bb0899001122
		summarizeBy: sum
		sourceColumn: total_calories

	measure 'Total Recipes' = COUNTROWS(fct_recipes)
		lineageTag: 88ff00ff-9900-aa11-bb22-cc0900112233

	measure 'Avg Rating' = AVERAGE(fct_recipes[rating])
		lineageTag: 9900ff00-aa11-bb22-cc33-dd1001223344
		formatString: 0.00

	measure 'Avg Calories' = AVERAGE(fct_recipes[calories_per_serving])
		lineageTag: aa11ff11-bb22-cc33-dd44-ee1102334455
		formatString: 0

	measure 'Avg Total Time' = AVERAGE(fct_recipes[total_time_minutes])
		lineageTag: bb22ff22-cc33-dd44-ee55-ff1203445566
		formatString: 0

	partition fct_recipes = m
		mode: import
		source =
				let
				  Source = Sql.Database("wsl.localhost", "analytics"),
				  tbl    = Source{[Schema="marts",Item="fct_recipes"]}[Data]
				in
				  tbl

	annotation PBI_ResultType = Table
