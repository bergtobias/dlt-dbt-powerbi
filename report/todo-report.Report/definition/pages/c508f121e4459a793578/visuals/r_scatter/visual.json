{
  "$schema": "https://developer.microsoft.com/json-schemas/fabric/item/report/definition/visualContainer/2.7.0/schema.json",
  "name": "r_scatter",
  "position": {
    "x": 260,
    "y": 270,
    "z": 5,
    "height": 450,
    "width": 620,
    "tabOrder": 5
  },
  "visual": {
    "visualType": "scatterChart",
    "query": {
      "queryState": {
        "X": {
          "projections": [
            {
              "field": {
                "Column": {
                  "Expression": {
                    "SourceRef": {
                      "Entity": "fct_recipes"
                    }
                  },
                  "Property": "total_time_minutes"
                }
              },
              "queryRef": "fct_recipes.total_time_minutes"
            }
          ]
        },
        "Y": {
          "projections": [
            {
              "field": {
                "Column": {
                  "Expression": {
                    "SourceRef": {
                      "Entity": "fct_recipes"
                    }
                  },
                  "Property": "calories_per_serving"
                }
              },
              "queryRef": "fct_recipes.calories_per_serving"
            }
          ]
        },
        "Details": {
          "projections": [
            {
              "field": {
                "Column": {
                  "Expression": {
                    "SourceRef": {
                      "Entity": "fct_recipes"
                    }
                  },
                  "Property": "name"
                }
              },
              "queryRef": "fct_recipes.name"
            }
          ]
        },
        "Size": {
          "projections": [
            {
              "field": {
                "Column": {
                  "Expression": {
                    "SourceRef": {
                      "Entity": "fct_recipes"
                    }
                  },
                  "Property": "review_count"
                }
              },
              "queryRef": "fct_recipes.review_count"
            }
          ]
        },
        "Play": {
          "projections": []
        }
      }
    },
    "drillFilterOtherVisuals": true,
    "visualContainerObjects": {
      "border": [
        {
          "properties": {
            "show": {
              "expr": {
                "Literal": {
                  "Value": "true"
                }
              }
            },
            "color": {
              "expr": {
                "Literal": {
                  "Value": "'#C4B5FD'"
                }
              }
            },
            "radius": {
              "expr": {
                "Literal": {
                  "Value": "12D"
                }
              }
            }
          }
        }
      ],
      "background": [
        {
          "properties": {
            "show": {
              "expr": {
                "Literal": {
                  "Value": "true"
                }
              }
            },
            "color": {
              "expr": {
                "Literal": {
                  "Value": "'#FFFFFF'"
                }
              }
            },
            "transparency": {
              "expr": {
                "Literal": {
                  "Value": "0D"
                }
              }
            }
          }
        }
      ]
    }
  }
}