table fct_posts
	lineageTag: e0d9e2b1-d426-4122-8fd3-a099fe72f46c

	measure 'Total Posts' = COUNTROWS(fct_posts)
		lineageTag: baab9585-ec86-46a9-9652-cc77bec7c785

	measure 'Avg Comments per Post' = AVERAGE(fct_posts[comment_count])
		formatString: 0.0
		lineageTag: 6359871f-f019-4d16-8901-e7342ea88996

	measure 'Posts with Comments' = CALCULATE(COUNTROWS(fct_posts), fct_posts[is_commented] = 1)
		lineageTag: c1d2e3f4-a5b6-7890-cdef-123456789012

